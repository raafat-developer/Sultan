# FAST MAN Backend Environment Configuration

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081,*

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastman?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="fastman_super_secret_jwt_access_key_2026_change_in_production!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="fastman_super_secret_jwt_refresh_key_2026_change_in_production!"
JWT_REFRESH_EXPIRES_IN="7d"

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID="fastman-delivery"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@fastman-delivery.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""

# Maps Integration (Google Maps API)
GOOGLE_MAPS_API_KEY=""

# Storage (Object Storage / Local)
STORAGE_DRIVER="local" # local, s3, r2
STORAGE_BUCKET="fastman-proofs"
STORAGE_LOCAL_PATH="./uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"

# Business & Operational Settings
DEFAULT_TIMEZONE="Africa/Cairo"
DEFAULT_CURRENCY="EGP"
AUTO_ASSIGN_RADIUS_KM=10
AUTO_ASSIGN_ENABLED=true
